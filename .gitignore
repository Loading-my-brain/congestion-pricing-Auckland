# Files and folders that stay on my computer and are not uploaded to GitHub

# R / RStudio session files
.Rproj.user/
.Rhistory
.RData
.RDataTmp*
.Ruserdata
# .Rprofile is machine-specific (Java path)
.Rprofile
*.log

# Word / Office lock files
~$*

# Quarto / RMarkdown helper folders
*_files/
*_cache/

# Data: only the README and my travel time CSVs go up
data/*
!data/README.md
!data/pt_time_cbd_r5r_20260513_0800.csv
!data/car_time_cbd_r5r_freeflow_inbound.csv
!data/car_time_cbd_r5r_freeflow.csv

# Scripts: only the clean scripts go up
Scripts/_archive/
Scripts/Documentation/
Scripts/images/
Scripts/clean/logs/
Scripts/clean/printouts/

# Figures: no drafts or notes
all_figures/bin/
all_figures/Notes_Hinami_figures/
all_figures/Figure/
all_figures/Rplot.png
*.pptx

# Other local folders
Bin/
rjavaenv/
rosm.cache/
Learning-notes/
Notes_Hinami_figures/
